# Supabase: Project Settings > Data API (URL) and Project Settings > API Keys.
# ANON_KEY = publishable key (sb_publishable_...) or legacy anon key.
# SERVICE_ROLE_KEY = secret key (sb_secret_...) or legacy service_role key. Server only, never NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# OWNER_EMAIL is also the only admin login allowed in (lib/admin-access.ts) — keep it the real owner account.
OWNER_EMAIL=
# Where new-reservation notification emails go. Normally the same as OWNER_EMAIL; only
# differs while Resend has no verified domain, since its sandbox sender can deliver to
# just one address (the Resend account's own).
RESERVATION_NOTIFICATION_EMAIL=
# "true" only after a custom domain is verified in Resend; until then guest emails are skipped.
RESEND_GUEST_EMAILS_ENABLED=
ICAL_EXPORT_TOKEN=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Booking.com iCal export per apartment: BOOKING_ICAL_URL_<SLUG>, e.g. de-lux → DE_LUX (temporary, moves to Supabase)
BOOKING_ICAL_URL_DE_LUX=
